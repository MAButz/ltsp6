# generic functions
usage() {
    cat <<USAGE_EOF
Usage: $0 [OPTION]

Displays information useful to troubleshooting issues on an LTSP
server. Information should include server distro and release,
versions of LTSP related packages installed on the server, LTSP
chroots and their package versions, the TFTP directories the clients
boot from, LTSP image files, and both places a client reads its
lts.conf(5) from - whether each one is there, and which of the two wins.

Options:
  -h, --help                    Displays the ltsp-info help message.
  -b, --base DIR                Look for chroots and images under DIR instead
                                of /opt/ltsp.
  -n, --no-server-info          Do not display server information.
  -v, --verbose                 Display more information, such as including the contents
                                of detected files.
      --version                 Output version information and exit.
USAGE_EOF
}

find_chroots() {
    if [ -d "$BASE" ]; then
        find -L "$BASE/" -mindepth 1 -maxdepth 1 -type d ! -name images
    fi
}

# The TFTP trees that exist. Empty output means none of TFTP_DIRS is there.
tftp_roots() {
    for tftpdir in $TFTP_DIRS ; do
        tftpboot="$tftpdir/$TFTP_BOOT_DIR"
        tftpboot=${tftpboot%/}
        if [ -d "$tftpboot" ]; then
            echo "$tftpboot"
        fi
    done
}

# Every architecture there is any evidence of: a chroot under BASE, or a
# directory in a TFTP tree that holds something a client boots with. The two
# need not agree - a chroot built under a different base leaves only the TFTP
# side behind, and an image put in place by hand leaves only that.
#
# A directory under the TFTP root counts only when it carries a kernel or an
# lts.conf. Anything can end up in there - a stray mkdir, a command whose help
# text was pasted at a shell - and listing each one as an architecture buries
# the real ones. Such a directory is still reported by find_tftp, with no boot
# file under it, so nothing is hidden by this.
find_arches() {
    {
        if [ -d "$BASE" ]; then
            find -L "$BASE/" -mindepth 1 -maxdepth 1 -type d ! -name images -printf '%f\n'
        fi
        for tftpboot in $(tftp_roots) ; do
            for dir in $(find -L "$tftpboot/" -mindepth 1 -maxdepth 1 -type d) ; do
                for f in "$dir"/lts.conf "$dir"/vmlinuz* ; do
                    if [ -f "$f" ]; then
                        basename "$dir"
                        break
                    fi
                done
            done
        done
    } | sort -u
}

# The TFTP tree is reported on its own, not once per chroot. The client reads
# its kernel from there and from nowhere else, so what is in there matters
# whether or not a chroot is still around: the chroot may have been built
# under a different BASE (ltsp-build-client --base), or removed once its image
# was in place. Tying this listing to the chroots, as it used to be, meant a
# server that boots clients perfectly reported nothing at all.
find_tftp() {
    found=""
    for tftpboot in $(tftp_roots) ; do
        for dir in $(find -L "$tftpboot/" -mindepth 1 -maxdepth 1 -type d | sort) ; do
            found="true"
            echo "found tftp directory: $dir"
            for f in "$dir"/vmlinuz* "$dir"/initrd* ; do
                if [ -f "$f" ]; then
                    echo "  boot file: $(basename "$f")"
                fi
            done
            echo
        done
    done
    if [ -z "$found" ]; then
        echo "no tftp directory found in: $TFTP_DIRS"
        echo "(each is looked at under its $TFTP_BOOT_DIR subdirectory; both are"
        echo " set in ltsp-server.conf(5))"
        echo
    fi
}

lts_conf_line() {
    file=$1
    note=$2
    if [ -f "$file" ]; then
        printf '  present  %-48s %s\n' "$file" "$note"
        if [ "$verbose" = "true" ]; then
            sed 's/^/             /' "$file"
        fi
    else
        printf '  missing  %-48s %s\n' "$file" "$note"
    fi
}

# Both places a client's lts.conf can come from, named in full and in the
# order that decides which one the client ends up with.
report_lts_conf() {
    echo "lts.conf, the two places a client reads it from:"
    echo "  init-ltsp fetches it over tftp from the directory the kernel came"
    echo "  from and writes it over /etc/lts.conf in the running client - but"
    echo "  only when the transfer returns a non-empty file. The tftp copy"
    echo "  therefore wins whenever it is there; the one in the image is what"
    echo "  is left when it is not - including when the client asks for a"
    echo "  directory that is not the one below, which fails silently."
    echo

    roots=$(tftp_roots)
    if [ -z "$roots" ]; then
        # None of them exists. Name the first anyway: a path to create is
        # more use than silence.
        set -- $TFTP_DIRS
        roots="$1/$TFTP_BOOT_DIR"
        roots=${roots%/}
    fi

    arches=$(find_arches)
    if [ -z "$arches" ]; then
        echo "  no architecture found under $BASE or in $TFTP_DIRS, so these are"
        echo "  the paths as such, with <arch> standing for amd64 and the like:"
        arches="<arch>"
    fi

    for arch in $arches ; do
        echo "$arch:"
        for tftpboot in $roots ; do
            lts_conf_line "$tftpboot/$arch/lts.conf" "served by tftp - takes precedence"
        done
        lts_conf_line "$BASE/$arch/etc/lts.conf" "in the chroot - the fallback"
        echo
    done
}

find_images() {
    if [ -d "$BASE/images" ]; then
        for image in $(find -L "$BASE/images/" -type f -name '*.img'); do
            echo found image: $image
            if [ "$verbose" = "true" ] && [ -x /usr/bin/file ]; then
                file $image
            fi
            echo
        done
    fi
}

# Distros may override that if they don't support lsb_release
server_info() {
    echo server information:
    lsb_release --all
    echo
}


# distro specific functions
server_packages() {
    die "Your distro needs to implement function server_packages in order to support $0."
}

chroot_packages() {
    die "Your distro needs to implement function chroot_packages in order to support $0."
}

chroot_release() {
    die "Your distro needs to implement function chroot_release in order to support $0."
}

# Set an optional MODULES_BASE, so help2man can be called from build env
MODULES_BASE=${MODULES_BASE:-/usr/share/ltsp}

# This also sources vendor functions and .conf file settings
. ${MODULES_BASE}/ltsp-server-functions

BASE=${BASE:-/opt/ltsp}                # LTSP base directory

while [ -n "$1" ] ; do
    case "$1" in
        --help|-h) usage; exit 0 ;;
        --base|-b)
            shift
            if [ -z "$1" ]; then
                echo "$0: --base needs a directory" >&2
                exit 1
            fi
            BASE="$1"
            ;;
        --base=*) BASE="${1#--base=}" ;;
        --no-server-info|-n) server_info="false" ;;
        --verbose|-v) verbose="true" ;;
        --version) ltsp_version; exit 0 ;;
        *) echo "$0: unknown option: $1" >&2; usage >&2; exit 1 ;;
    esac
    shift
done

export BASE

if [ "$server_info" != "false" ]; then
    server_info
    server_packages
fi
chroots=$(find_chroots)
if [ -z "$chroots" ]; then
    echo "no chroot under $BASE"
    echo "(that is normal when the image was built elsewhere; ltsp-info -b DIR"
    echo " looks at another base)"
    echo
fi
for chroot in $chroots ; do
    chroot_name=$(basename $chroot)
    if [ "$verbose" = "true" ]; then
        chroot_release
    fi
    chroot_packages $chroot
done
find_tftp
report_lts_conf
find_images
