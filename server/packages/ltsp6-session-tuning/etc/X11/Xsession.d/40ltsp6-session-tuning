# Keep a desktop session's scratch data off the network home directory, and
# give this host's own defaults precedence over the packaged ones.
#
# Sourced by /etc/X11/Xsession, which runs with "set -e" - so every command
# here has to be guarded. It is numbered below 55xfce4-session on purpose:
# startxfce4 keeps a pre-set XDG_CONFIG_DIRS and only appends /etc/xdg to it,
# so prepending our directory has to happen first.

# ---- 1. XDG_CACHE_HOME on local disk -------------------------------------
#
# ~/.cache is the busiest directory a desktop session has: fontconfig caches,
# icon caches, thumbnails, GTK and browser caches. With home directories on
# NFS, every one of those becomes network traffic, multiplied by the number of
# sessions on the host - and none of it is worth preserving between logins.
#
# The ownership test is not paranoia: the cache root is world-writable with a
# sticky bit (like /tmp), so another user could have created the directory for
# our uid first. "-O" is true only if we own it; if we do not, the session
# silently keeps the default ~/.cache rather than writing into someone else's
# directory.
if [ -d /var/cache/ltsp6-sessions ]; then
    _ltsp6_cache="/var/cache/ltsp6-sessions/$(id -u)"
    mkdir -p "$_ltsp6_cache" 2>/dev/null || true
    if [ -d "$_ltsp6_cache" ] && [ ! -L "$_ltsp6_cache" ] && [ -O "$_ltsp6_cache" ]; then
        chmod 700 "$_ltsp6_cache" 2>/dev/null || true
        XDG_CACHE_HOME="$_ltsp6_cache"
        export XDG_CACHE_HOME
    fi
    unset _ltsp6_cache
fi

# ---- 2. our own xfconf defaults ------------------------------------------
#
# Shipping into /etc/xdg directly would collide with conffiles that belong to
# the Xfce packages. A directory of our own, prepended here, gives the same
# precedence without touching another package's files.
if [ -d /etc/xdg/ltsp6 ]; then
    case ":${XDG_CONFIG_DIRS}:" in
        *":/etc/xdg/ltsp6:"*) : ;;
        *) XDG_CONFIG_DIRS="/etc/xdg/ltsp6${XDG_CONFIG_DIRS:+:$XDG_CONFIG_DIRS}"
           export XDG_CONFIG_DIRS ;;
    esac
fi

# ---- 3. screen saver policy ----------------------------------------------
#
# An animated screen saver in an idle RDP session is drawn, encoded and sent
# to the client for nobody to see - multiplied by every idle session on the
# host. Settings live in /etc/default/ltsp6-session-tuning; they are written
# into ~/.xscreensaver at each login, so a change a user makes lasts until
# the next login at most. xscreensaver reads that file again when it
# changes, and anything not set there comes from its app-defaults.
#
# xscreensaver is also started from here when the user has hidden its
# autostart entry; a second instance would refuse to start, so this is
# harmless when the autostart entry ran too.
if [ -r /etc/default/ltsp6-session-tuning ]; then
    _ltsp6_policy=no; _ltsp6_start=no
    _ltsp6_mode=blank; _ltsp6_lock=True; _ltsp6_timeout=0:05:00
    while IFS='=' read -r _ltsp6_k _ltsp6_v; do
        case "$_ltsp6_k" in
            SCREENSAVER_POLICY)  _ltsp6_policy=$_ltsp6_v ;;
            SCREENSAVER_MODE)    _ltsp6_mode=$_ltsp6_v ;;
            SCREENSAVER_LOCK)    _ltsp6_lock=$_ltsp6_v ;;
            SCREENSAVER_TIMEOUT) _ltsp6_timeout=$_ltsp6_v ;;
            SCREENSAVER_START)   _ltsp6_start=$_ltsp6_v ;;
        esac
    done < /etc/default/ltsp6-session-tuning || true
    if [ "$_ltsp6_policy" = yes ] && [ -n "$HOME" ]; then
        _ltsp6_xs="$HOME/.xscreensaver"
        if [ -f "$_ltsp6_xs" ] && [ ! -L "$_ltsp6_xs" ]; then
            sed -i -E \
                -e "s/^(mode:[[:space:]]*).*/\1$_ltsp6_mode/" \
                -e "s/^(lock:[[:space:]]*).*/\1$_ltsp6_lock/" \
                -e "s/^(timeout:[[:space:]]*).*/\1$_ltsp6_timeout/" \
                "$_ltsp6_xs" 2>/dev/null || true
        elif [ ! -e "$_ltsp6_xs" ]; then
            printf 'mode:\t\t%s\nlock:\t\t%s\ntimeout:\t%s\n' \
                "$_ltsp6_mode" "$_ltsp6_lock" "$_ltsp6_timeout" \
                > "$_ltsp6_xs" 2>/dev/null || true
        fi
        unset _ltsp6_xs
    fi
    if [ "$_ltsp6_start" = yes ] && command -v xscreensaver >/dev/null 2>&1; then
        ( sleep 5; pgrep -u "$(id -u)" -x xscreensaver >/dev/null 2>&1 \
              || exec xscreensaver -no-splash ) >/dev/null 2>&1 &
    fi
    unset _ltsp6_policy _ltsp6_start _ltsp6_mode _ltsp6_lock _ltsp6_timeout _ltsp6_k _ltsp6_v
fi
