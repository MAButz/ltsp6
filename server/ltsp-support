#!/usr/bin/env python3
#
# Start a remote support session against a client, from the LTSP server.
#
#     ltsp-support                 pick a client from the list
#     ltsp-support ltsp29          straight to that one
#     ltsp-support ltsp29 :8       and a particular display on it
#
# What it does, in order: open an ssh connection to the client with a port
# forward, run ltsp-shadow(8) there, wait for the user to agree, and then open
# an RDP client on the forwarded port. Closing that window ends the ssh
# session, which ends the shadow server and takes the marker off the user's
# screen with it.
#
# The forward is to 127.0.0.1 at both ends, so the picture never crosses the
# network unencrypted and there is no listening port on the client for anyone
# else to find. The authentication is the ssh key named in SSH_AUTHORIZED_KEY_n
# in lts.conf - see lts.conf(5), section REMOTE SUPPORT.
#
# Settings, from /etc/ltsp/ltsp-server.conf or the environment, the
# environment winning so a single session can differ:
#
#     SUPPORT_KEY=/root/.ssh/ltsp-clients    the key to log in with
#     SUPPORT_PORT=3390                      local port for the forward
#     SUPPORT_RDP_CLIENT=xfreerdp3           what to watch it with
#     SUPPORT_LEASES=/var/lib/misc/dnsmasq.leases   where to find clients
#
# The waiting is the part worth naming: the forwarded port only opens once
# ltsp-shadow has been allowed to start the shadow server, so waiting for the
# port is waiting for a person, not for a service.

import os
import re
import shlex
import subprocess
import sys

try:
    import gi

    gi.require_version("Gtk", "3.0")
    gi.require_version("Gdk", "3.0")
    from gi.repository import Gdk, GLib, Gtk, Pango
except (ImportError, ValueError) as err:
    sys.stderr.write("ltsp-support: %s\n" % err)
    sys.stderr.write("ltsp-support: needs python3-gi and gir1.2-gtk-3.0\n")
    sys.exit(2)

CONF = "/etc/ltsp/ltsp-server.conf"
SHADOW = "/usr/share/ltsp/ltsp-shadow"
VIEWERS = ("xfreerdp3", "xfreerdp", "wlfreerdp", "remmina")
CONSENT_TIMEOUT = 300

CSS = b"""
.ltsp-support-heading {
    font-weight: bold;
    font-size: 1.15em;
}
.ltsp-support-dim {
    opacity: 0.7;
}
.ltsp-support-error {
    color: #a51c10;
}
"""


def conf_values(path):
    """The shell-style settings file, read without running it.

    ltsp-server.conf is sourced by shell scripts elsewhere, but sourcing it
    here would mean handing a file to a shell for no better reason than
    reading four values out of it.
    """
    values = {}
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            for line in fh:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                name, _, raw = line.partition("=")
                name = name.strip()
                if not re.match(r"^[A-Za-z_][A-Za-z0-9_]*$", name):
                    continue
                try:
                    parts = shlex.split(raw, comments=True)
                except ValueError:
                    continue
                values[name] = parts[0] if parts else ""
    except OSError:
        pass
    return values


def setting(name, default, from_file):
    value = os.environ.get(name)
    if value:
        return value
    return from_file.get(name) or default


def leases(path):
    """Clients that have actually booted, from dnsmasq's lease file.

    Columns: expiry, mac, address, name, client-id. A name of "*" means
    dnsmasq never learned one, and the address is then all there is.
    """
    found = []
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            for line in fh:
                parts = line.split()
                if len(parts) < 4:
                    continue
                mac, address, name = parts[1], parts[2], parts[3]
                if name == "*":
                    name = ""
                found.append((name, address, mac))
    except OSError:
        return []
    found.sort(key=lambda row: (row[0] == "", row[0], row[1]))
    return found


def port_is_open(port):
    """Is anything listening on 127.0.0.1:port?

    Read from the kernel's own table rather than through ss or netstat,
    neither of which is certain to be installed. Columns are local address
    and connection state, both hexadecimal; 0A is LISTEN and 0100007F is
    127.0.0.1 written little-endian.
    """
    want = "0100007F:%04X" % port
    try:
        with open("/proc/net/tcp", encoding="ascii", errors="replace") as fh:
            next(fh, None)
            for line in fh:
                parts = line.split()
                if len(parts) > 3 and parts[1] == want and parts[3] == "0A":
                    return True
    except OSError:
        pass
    return False


def valid_display(text):
    return bool(re.match(r"^:?[0-9]{1,2}$", text))


class Support(Gtk.Window):
    def __init__(self, client=None, display=""):
        Gtk.Window.__init__(self, title="LTSP remote support")
        self.set_default_size(560, 420)
        self.set_border_width(0)

        values = conf_values(CONF)
        self.key = setting("SUPPORT_KEY", "/root/.ssh/ltsp-clients", values)
        self.port = int(setting("SUPPORT_PORT", "3390", values))
        self.leases_path = setting("SUPPORT_LEASES",
                                   "/var/lib/misc/dnsmasq.leases", values)
        self.viewer = setting("SUPPORT_RDP_CLIENT", "", values)
        if not self.viewer:
            for candidate in VIEWERS:
                if GLib.find_program_in_path(candidate):
                    self.viewer = candidate
                    break

        self.ssh = None
        self.rdp = None
        self.waited = 0
        self.timer = None
        self.client = None
        self.display = display

        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
        self.add(self.stack)
        self.stack.add_named(self.build_pick(), "pick")
        self.stack.add_named(self.build_busy(), "busy")

        self.connect("delete-event", self.on_close)

        if not os.access(self.key, os.R_OK):
            self.complain(
                "No ssh key at %s.\n\nGenerate one and put its public half "
                "into lts.conf as SSH_AUTHORIZED_KEY_0:\n"
                "    ssh-keygen -t ed25519 -N '' -f %s" % (self.key, self.key))
        elif not self.viewer:
            self.complain("No RDP client found. Install freerdp3-x11, or set "
                          "SUPPORT_RDP_CLIENT in %s." % CONF)

        self.refresh(None)
        # Not started here: a Gtk.Stack ignores a change of page while its
        # children are still invisible, so a client named on the command line
        # would put the session behind the list it was meant to skip. main()
        # calls this once the window is up.
        self.autostart = client

    def autostart_now(self):
        if self.autostart:
            self.start(self.autostart, self.display)
            self.autostart = None
        return False

    # ---- the list of clients ------------------------------------------------
    def build_pick(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        box.set_border_width(16)

        heading = Gtk.Label(xalign=0, label="Which client needs help?")
        heading.get_style_context().add_class("ltsp-support-heading")
        box.pack_start(heading, False, False, 0)

        sub = Gtk.Label(xalign=0, label="The user there is asked first, and a "
                        "marker stays on their screen while you watch.")
        sub.get_style_context().add_class("ltsp-support-dim")
        sub.set_line_wrap(True)
        box.pack_start(sub, False, False, 0)

        self.store = Gtk.ListStore(str, str, str)
        self.view = Gtk.TreeView(model=self.store)
        self.view.set_headers_visible(True)
        for i, title in enumerate(("Name", "Address", "MAC")):
            cell = Gtk.CellRendererText()
            cell.set_property("ellipsize", Pango.EllipsizeMode.END)
            column = Gtk.TreeViewColumn(title, cell, text=i)
            column.set_expand(i < 2)
            if title == "MAC":
                column.set_min_width(150)
            self.view.append_column(column)
        self.view.connect("row-activated", lambda *_a: self.on_connect(None))

        scroller = Gtk.ScrolledWindow()
        scroller.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
        scroller.set_shadow_type(Gtk.ShadowType.IN)
        scroller.add(self.view)
        box.pack_start(scroller, True, True, 0)

        self.note = Gtk.Label(xalign=0)
        self.note.set_line_wrap(True)
        self.note.get_style_context().add_class("ltsp-support-error")
        box.pack_start(self.note, False, False, 0)

        entries = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self.manual = Gtk.Entry()
        self.manual.set_placeholder_text("or a name or address")
        self.manual.connect("activate", self.on_connect)
        entries.pack_start(self.manual, True, True, 0)

        self.display_entry = Gtk.Entry()
        self.display_entry.set_width_chars(6)
        self.display_entry.set_placeholder_text("display")
        self.display_entry.set_tooltip_text(
            "Which X display to watch, :7 for instance. Empty takes the "
            "screen the user is looking at, which is the right answer unless "
            "this client runs more than one X server.")
        if self.display:
            self.display_entry.set_text(self.display)
        entries.pack_start(self.display_entry, False, False, 0)
        box.pack_start(entries, False, False, 0)

        buttons = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        buttons.set_halign(Gtk.Align.END)
        refresh = Gtk.Button(label="Refresh")
        refresh.connect("clicked", self.refresh)
        connect = Gtk.Button(label="Ask to connect")
        connect.get_style_context().add_class("suggested-action")
        connect.connect("clicked", self.on_connect)
        buttons.pack_start(refresh, False, False, 0)
        buttons.pack_start(connect, False, False, 0)
        box.pack_start(buttons, False, False, 0)
        return box

    # ---- waiting, and the session -------------------------------------------
    def build_busy(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        box.set_border_width(24)
        box.set_valign(Gtk.Align.CENTER)

        self.spinner = Gtk.Spinner()
        self.spinner.set_size_request(32, 32)
        box.pack_start(self.spinner, False, False, 0)

        self.busy_heading = Gtk.Label()
        self.busy_heading.get_style_context().add_class("ltsp-support-heading")
        self.busy_heading.set_line_wrap(True)
        box.pack_start(self.busy_heading, False, False, 0)

        self.busy_text = Gtk.Label()
        self.busy_text.set_line_wrap(True)
        self.busy_text.set_justify(Gtk.Justification.CENTER)
        self.busy_text.get_style_context().add_class("ltsp-support-dim")
        box.pack_start(self.busy_text, False, False, 0)

        self.busy_button = Gtk.Button(label="Cancel")
        self.busy_button.set_halign(Gtk.Align.CENTER)
        self.busy_button.connect("clicked", lambda _b: self.stop("Cancelled."))
        box.pack_start(self.busy_button, False, False, 0)
        return box

    def refresh(self, _button):
        self.store.clear()
        rows = leases(self.leases_path)
        for name, address, mac in rows:
            self.store.append([name or "(no name)", address, mac])
        if not rows:
            self.note.set_text(
                "No clients in %s - name one below instead."
                % self.leases_path)
        else:
            self.note.set_text("")

    def complain(self, text):
        self.note.set_text(text)

    def chosen_client(self):
        typed = self.manual.get_text().strip()
        if typed:
            return typed
        model, it = self.view.get_selection().get_selected()
        if it is None:
            return None
        name, address = model[it][0], model[it][1]
        # The address, not the name: dnsmasq knows the name, this machine's
        # resolver may well not.
        return address or name

    def on_connect(self, _widget):
        client = self.chosen_client()
        if not client:
            self.complain("Pick a client from the list, or type a name.")
            return
        display = self.display_entry.get_text().strip()
        if display and not valid_display(display):
            self.complain("'%s' is not a display; use :7." % display)
            return
        self.start(client, display)

    def start(self, client, display):
        if not os.access(self.key, os.R_OK) or not self.viewer:
            return
        if port_is_open(self.port):
            self.complain(
                "Port %d is already in use - another support session is "
                "probably still open. Close it, or set SUPPORT_PORT."
                % self.port)
            return

        self.client = client
        self.display = display
        self.waited = 0

        command = [
            "ssh", "-i", self.key,
            # A forward to ::1 fails on a network without IPv6 and prints
            # something that reads like the whole thing has gone wrong, when
            # in fact the IPv4 forward is up.
            "-o", "AddressFamily=inet",
            "-o", "StrictHostKeyChecking=no",
            "-o", "UserKnownHostsFile=/dev/null",
            "-o", "LogLevel=ERROR",
            "-o", "BatchMode=yes",
            "-o", "ConnectTimeout=10",
            "-L", "%d:127.0.0.1:%d" % (self.port, self.port),
            "root@%s" % client,
        ]
        remote = SHADOW
        if display:
            remote += " " + display
        command.append(remote)

        try:
            self.ssh = subprocess.Popen(
                command, stdin=subprocess.DEVNULL,
                stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                universal_newlines=True)
        except OSError as err:
            self.complain("Cannot run ssh: %s" % err)
            return

        self.busy_heading.set_text("Asking %s" % client)
        self.busy_text.set_text(
            "The user there has been asked whether you may watch.\n"
            "Nothing is shown until they agree.")
        self.busy_button.set_label("Cancel")
        self.spinner.start()
        self.stack.set_visible_child_name("busy")
        self.timer = GLib.timeout_add_seconds(1, self.tick)

    def tick(self):
        if self.rdp is not None:
            if self.rdp.poll() is not None:
                self.stop(None)
                return False
            if self.ssh is not None and self.ssh.poll() is not None:
                self.stop("The connection to %s ended." % self.client)
                return False
            return True

        if self.ssh is None:
            return False

        if port_is_open(self.port):
            self.watch()
            return True

        if self.ssh.poll() is not None:
            output = ""
            if self.ssh.stdout:
                output = self.ssh.stdout.read() or ""
            if "did not allow" in output:
                self.stop("The user at %s did not agree." % self.client)
            else:
                first = output.strip().splitlines()
                self.stop("The connection to %s ended before it started.\n\n%s"
                          % (self.client, first[0] if first else ""))
            return False

        self.waited += 1
        if self.waited >= CONSENT_TIMEOUT:
            self.stop("No answer from the user at %s." % self.client)
            return False

        left = CONSENT_TIMEOUT - self.waited
        self.busy_text.set_text(
            "The user there has been asked whether you may watch.\n"
            "Nothing is shown until they agree.\n\n"
            "Giving up in %d:%02d." % (left // 60, left % 60))
        return True

    def watch(self):
        """Consent given: the port is open, so open the picture."""
        if self.viewer == "remmina":
            command = [self.viewer, "-c", "rdp://127.0.0.1:%d" % self.port]
        else:
            command = [self.viewer, "/v:127.0.0.1:%d" % self.port,
                       "/sec:rdp", "+clipboard", "/dynamic-resolution"]
        try:
            self.rdp = subprocess.Popen(command, stdin=subprocess.DEVNULL)
        except OSError as err:
            self.stop("Cannot run %s: %s" % (self.viewer, err))
            return
        self.spinner.stop()
        self.busy_heading.set_text("Watching %s" % self.client)
        self.busy_text.set_text(
            "The session is open in %s. A marker stays on the user's screen "
            "for as long as this lasts.\n\nClosing that window, or this one, "
            "ends it." % self.viewer)
        self.busy_button.set_label("End session")

    def stop(self, message):
        if self.timer is not None:
            GLib.source_remove(self.timer)
            self.timer = None
        for proc in (self.rdp, self.ssh):
            if proc is not None and proc.poll() is None:
                proc.terminate()
        self.rdp = None
        self.ssh = None
        self.spinner.stop()
        self.stack.set_visible_child_name("pick")
        # Refresh first: it writes to the same label, and the reason this
        # session ended matters more than the state of the lease file.
        self.refresh(None)
        if message:
            self.note.set_text(message)

    def on_close(self, *_args):
        self.stop(None)
        Gtk.main_quit()
        return False


def main():
    args = [a for a in sys.argv[1:] if not a.startswith("-")]
    if "-h" in sys.argv or "--help" in sys.argv:
        sys.stdout.write(__doc__ or "usage: ltsp-support [client] [display]\n")
        return 0

    client = args[0] if args else None
    display = args[1] if len(args) > 1 else ""
    if display and not valid_display(display):
        sys.stderr.write("ltsp-support: '%s' is not a display; use :7\n"
                         % display)
        return 1

    if not os.environ.get("DISPLAY") and not os.environ.get("WAYLAND_DISPLAY"):
        sys.stderr.write("ltsp-support: no display - and the picture would "
                         "have nowhere to go either\n")
        return 2
    if not Gtk.init_check([])[0]:
        sys.stderr.write("ltsp-support: cannot open the display\n")
        return 2

    provider = Gtk.CssProvider()
    provider.load_from_data(CSS)
    Gtk.StyleContext.add_provider_for_screen(
        Gdk.Screen.get_default(), provider,
        Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    win = Support(client, display)
    win.show_all()
    GLib.idle_add(win.autostart_now)
    Gtk.main()
    return 0


if __name__ == "__main__":
    sys.exit(main())
