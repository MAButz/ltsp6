#!/bin/sh
# Build or refresh the signed apt archive that GitHub Pages serves.
#
# The archive lives on its own branch of this repository (an orphan branch, so
# it shares no history with the source) and is published by GitHub Pages, which
# makes it reachable over HTTPS at
#
#     https://<user>.github.io/<repo>
#
# Clients then use a normal deb line. The only thing that makes this a real
# archive rather than a directory of files is the signature: without it apt
# refuses the repository unless the administrator writes [trusted=yes], which
# disables verification for every package from that source. On a fleet of thin
# clients installing software as root, that is not a corner to cut.
#
# Usage:
#   build-apt-repo <repo-dir> [<suite> <package.deb> ...]
#
#   build-apt-repo /srv/ltsp6-apt
#   build-apt-repo /srv/ltsp6-apt trixie ../ltsp6-session-tuning_1.0.0_all.deb
#
# The signing key is looked up in $GNUPGHOME (default: the caller's ~/.gnupg).
# Set LTSP6_REPO_KEY to a fingerprint to pick a specific one; otherwise the
# single available secret key is used.
#
# Needs: reprepro, gpg.

set -e

usage() {
    echo "Usage: $0 <repo-dir> [<suite> <package.deb> ...]" >&2
    exit 2
}

[ $# -ge 1 ] || usage
REPO=$1
shift

for tool in reprepro gpg; do
    command -v "$tool" >/dev/null 2>&1 || {
        echo "$tool is not installed" >&2
        exit 1
    }
done

[ -d "$REPO" ] || { echo "$REPO does not exist" >&2; exit 1; }

# ------------------------------------------------------------------ the key
if [ -n "$LTSP6_REPO_KEY" ]; then
    KEYID=$LTSP6_REPO_KEY
else
    KEYID=$(gpg --list-secret-keys --with-colons 2>/dev/null |
            awk -F: '/^fpr:/{print $10; exit}')
fi
[ -n "$KEYID" ] || {
    echo "no secret key found - generate one first, or set LTSP6_REPO_KEY" >&2
    exit 1
}
echo "==> signing with $KEYID"

# ------------------------------------------------------------------ layout
mkdir -p "$REPO/conf"

# One stanza per suite. bookworm is kept because packages were published for
# it; trixie is what the current lab runs. A suite costs nothing but an index,
# and removing one silently breaks whoever still points at it.
#
# SignWith is the whole point of this file: reprepro then writes InRelease
# (inline signature) and Release.gpg (detached) on every export, which is what
# apt checks. Without this line the export succeeds and produces an archive
# no client will trust.
cat > "$REPO/conf/distributions" <<EOF
Origin: ltsp6
Label: ltsp6 Github
Suite: stable
Codename: bookworm
Architectures: amd64
Components: main
Description: Debian ltsp6 x64 github repository
SignWith: $KEYID

Origin: ltsp6
Label: ltsp6 Github
Suite: stable
Codename: trixie
Architectures: amd64
Components: main
Description: Debian 13 (trixie) ltsp6 repository
SignWith: $KEYID
EOF

# GitHub Pages runs Jekyll over the branch unless told not to. Jekyll skips
# files and directories whose names begin with a dot or an underscore, which
# an apt archive does not have - but it also rewrites and omits things
# unpredictably, and the archive's checksums have to match byte for byte.
# .nojekyll turns the processing off and serves the tree verbatim.
: > "$REPO/.nojekyll"

# The public key, for clients. Both forms: apt reads either, and the armoured
# one survives being pasted into a terminal or a configuration manager.
gpg --armor --export "$KEYID" > "$REPO/ltsp6-archive-keyring.asc"
gpg --export "$KEYID" > "$REPO/ltsp6-archive-keyring.gpg"

# reprepro's db/ is local state rebuilt from conf/ and pool/, not source. It is
# a Berkeley DB, so committing it adds a binary blob to every publish for no
# gain - and the archive can always be regenerated by re-running this script.
if ! grep -qx 'db/' "$REPO/.gitignore" 2>/dev/null; then
    printf 'db/\nincoming/\n' >> "$REPO/.gitignore"
fi

# ------------------------------------------------------------- safety net
# reprepro's db/ is local state and deliberately not committed, so a fresh
# checkout starts with an empty database: the .debs are all still in pool/,
# but nothing indexes them. Include one package into a suite from that state
# and the export cheerfully publishes a suite containing only that package,
# silently dropping everything that was there before. Found the hard way -
# one publish took bookworm from two packages to none.
#
# The mapping from pool to suite cannot be recovered from pool/ alone, so this
# cannot repair itself. What it can do is refuse to publish the loss.
BEFORE=$(mktemp)
for suite_dir in "$REPO"/dists/*/; do
    [ -d "$suite_dir" ] || continue
    suite=$(basename "$suite_dir")
    for pkgfile in "$suite_dir"main/binary-*/Packages; do
        [ -f "$pkgfile" ] || continue
        awk -v s="$suite" '/^Package: /{print s" "$2}' "$pkgfile"
    done
done | sort -u > "$BEFORE"

# ------------------------------------------------------------------ include
if [ $# -gt 0 ]; then
    SUITE=$1
    shift
    [ $# -gt 0 ] || { echo "no .deb given for suite $SUITE" >&2; exit 2; }
    for deb in "$@"; do
        [ -f "$deb" ] || { echo "$deb not found" >&2; exit 1; }
        echo "==> including $(basename "$deb") in $SUITE"
        # includedeb replaces an existing version of the same package in that
        # suite, so re-running with a rebuilt package is the normal update path.
        reprepro -b "$REPO" includedeb "$SUITE" "$deb"
    done
fi

# ------------------------------------------------------------------ export
echo "==> exporting and signing all suites"
reprepro -b "$REPO" export

AFTER=$(mktemp)
for suite_dir in "$REPO"/dists/*/; do
    [ -d "$suite_dir" ] || continue
    suite=$(basename "$suite_dir")
    for pkgfile in "$suite_dir"main/binary-*/Packages; do
        [ -f "$pkgfile" ] || continue
        awk -v s="$suite" '/^Package: /{print s" "$2}' "$pkgfile"
    done
done | sort -u > "$AFTER"

LOST=$(comm -23 "$BEFORE" "$AFTER")
rm -f "$BEFORE" "$AFTER"
if [ -n "$LOST" ]; then
    echo
    echo "REFUSING TO PUBLISH: this export would remove packages that were" >&2
    echo "already published:" >&2
    echo "$LOST" | sed 's/^/    /' >&2
    echo >&2
    echo "Almost certainly an empty reprepro database (db/ is not committed)." >&2
    echo "Re-include the missing packages from pool/ in the same run, e.g." >&2
    echo "    $0 $REPO bookworm $REPO/pool/main/l/ltsp/ltsp-client_*.deb" >&2
    echo "and repeat for each suite, then publish. Set LTSP6_ALLOW_REMOVALS=1" >&2
    echo "if a package really is meant to disappear." >&2
    [ "${LTSP6_ALLOW_REMOVALS:-}" = 1 ] || exit 1
    echo "LTSP6_ALLOW_REMOVALS=1 set - continuing anyway." >&2
fi

echo "==> verification"
for suite in bookworm trixie; do
    d="$REPO/dists/$suite"
    [ -d "$d" ] || continue
    printf '    %-9s' "$suite"
    if [ -f "$d/InRelease" ] && [ -f "$d/Release.gpg" ]; then
        # gpg --verify on the inline-signed file proves the signature covers
        # the index checksums a client will act on.
        if gpg --verify "$d/InRelease" >/dev/null 2>&1; then
            printf 'signed and verified'
        else
            printf 'SIGNATURE DOES NOT VERIFY'
        fi
    else
        printf 'NOT SIGNED (no InRelease/Release.gpg)'
    fi
    n=$(grep -c '^Package: ' "$d/main/binary-amd64/Packages" 2>/dev/null || echo 0)
    printf '  %s package(s)\n' "$n"
done
echo "==> done"
