# looked up in the wrong scope and silently ignored, and the port was opened
# twice, which ended the daemon after the first job. Nobody had a serial
# printer left to notice.

"""
usage: jetpipe [-d] <device> <port>

Forward everything sent to TCP <port> to the printer <device>, one connection
at a time - a printer cannot interleave two jobs anyway.

  -d, --debug   stay in the foreground and log to stderr (as under systemd)
  -h, --help    show this text

No security measures are implemented: anyone who can reach the port can print.
"""

import errno
import getopt
import os
import socket
import sys

CHUNK = 65536
# A job that stops sending for this long is abandoned, so that a client that
# went away without closing its connection cannot hold the printer forever.
IDLE_TIMEOUT = 600


def log(*args):
    print("jetpipe:", *args, file=sys.stderr, flush=True)


def open_printer(devicename):
    # No O_CREAT: a printer that is not plugged in must be an error, not a
    # new regular file under /dev that swallows every job sent to it.
    return os.open(devicename, os.O_WRONLY | os.O_NOCTTY)


def write_all(fd, data):
    view = memoryview(data)
    while view:
        written = os.write(fd, view)
        view = view[written:]


def serve_one(connection, addr, devicename):
    """Copy one job from the connection to the printer. Never raises."""
    connection.settimeout(IDLE_TIMEOUT)
    try:
        fd = open_printer(devicename)
    except OSError as e:
        # The client sees the connection close at once and will retry, which
        # is what CUPS does with a printer that is switched off.
        log(f"{addr[0]}: cannot open {devicename}: {e.strerror}")
        return

    total = 0
    try:
        while True:
            try:
                data = connection.recv(CHUNK)
            except socket.timeout:
                log(f"{addr[0]}: nothing received for {IDLE_TIMEOUT}s, job abandoned")
                break
            except OSError as e:
                log(f"{addr[0]}: connection error: {e.strerror}")
                break
            if not data:
                break
            try:
                write_all(fd, data)
            except OSError as e:
                # EIO when the printer is unplugged mid-job, ENOSPC and the
                # like for anything else. Stop here; retrying the same write
                # in a loop is what used to spin at full load.
                log(f"{addr[0]}: writing to {devicename} failed after {total} bytes: {e.strerror}")
                break
            total += len(data)
    finally:
        os.close(fd)
    log(f"{addr[0]}: {total} bytes sent to {devicename}")


def run_server(devicename, port):
    srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    # Without this a restart right after the previous instance stopped fails
    # with "Address already in use" until the old connection's TIME_WAIT ends.
    srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    srv.bind(("", port))
    srv.listen(1)
    log(f"forwarding port {port} to {devicename}")

    while True:
        try:
            connection, addr = srv.accept()
        except OSError as e:
            if e.errno == errno.EINTR:
                continue
            log(f"accept failed: {e.strerror}")
            continue
        try:
            serve_one(connection, addr, devicename)
        finally:
            try:
                connection.close()
            except OSError:
                pass


def main(argv):
    try:
        opts, args = getopt.getopt(argv, "dh", ["debug", "help"])
    except getopt.GetoptError as e:
        print(f"jetpipe: {e}", file=sys.stderr)
        print(__doc__, file=sys.stderr)
        return 2

    debug = False
    for o, _ in opts:
        if o in ("-h", "--help"):
            print(__doc__)
            return 0
        if o in ("-d", "--debug"):
            debug = True

    if len(args) != 2:
        print(__doc__, file=sys.stderr)
        return 2
    devicename, port = args

    if devicename.startswith("/dev/tty"):
        print(f"jetpipe: {devicename} is a serial port; serial printers are no "
              "longer supported", file=sys.stderr)
        return 2
    try:
        port = int(port)
    except ValueError:
        print(f"jetpipe: port must be a number, not {port!r}", file=sys.stderr)
        return 2

    if not debug:
        if os.fork():
            return 0
        os.setsid()
        null = os.open(os.devnull, os.O_RDWR)
        for fd in (0, 1, 2):
            os.dup2(null, fd)

    run_server(devicename, port)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
